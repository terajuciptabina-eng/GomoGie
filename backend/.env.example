# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://gomogie:change-this-local-password@db:5432/gomogie
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=15m
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_JSON_BODY_BYTES=1048576

# Cloudflare R2 — leave blank to disable media-upload endpoints.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_URL_TTL_SECONDS=300
R2_MAX_IMAGE_BYTES=10485760
R2_MAX_VIDEO_BYTES=104857600
